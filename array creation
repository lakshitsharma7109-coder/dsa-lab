#include <stdio.h>
int main() {
    int a[100],n;
    printf("Enter the no. of elements in array:");
    scanf("%d",&n);
    printf("Enter array elements:\n");
    for(int i=0;i<n;i++) {
        scanf("%d",&a[i]);
    }
    printf("The array elements are:\n");
    for(int i=0;i<n;i++) {
        printf("%d ",a[i]);
    }
    return 0;
}
