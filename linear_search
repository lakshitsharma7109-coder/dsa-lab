#include <stdio.h>
int main()
{
    int a[100], n, key, i, found = 0;
    scanf("%d", &n);
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    scanf("%d", &key);
    for(i = 0; i < n; i++)
    {
        if(a[i] == key)
        {
            printf("Element found at index %d", i);
            found = 1;
            break;
        }
    }
    if(found == 0)
        printf("Element not found");
    return 0;
}
